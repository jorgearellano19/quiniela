# Safe local defaults for the Docker Compose databases. Override DATABASE_URL
# with a Neon URL only in a private deployment environment.
DATABASE_URL=postgresql://quiniela:quiniela@localhost:5432/quiniela
TEST_DATABASE_URL=postgresql://quiniela:quiniela@localhost:5432/quiniela_test
BETTER_AUTH_SECRET=local-development-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
